{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "integration-ops-console",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "integration-ops-console-demo",
      "database_id": "feac7092-b882-4d0d-8570-c56bafb5f919"
    }
  ]
}
